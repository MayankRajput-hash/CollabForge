# Supabase Backend Configuration
# Obtain these credentials from your Supabase Project Dashboard -> Settings -> API
# Replace both placeholders with real values. In Vercel, set them as environment
# variables and redeploy; never use a Supabase service_role/secret key in the frontend.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
